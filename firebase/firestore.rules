rules_version = '2';

// DEC-009/DEC-040: o aplicativo apenas lê o catálogo oficial; não há escrita pelo app.
// A carga de dados no emulador usa o acesso administrativo ("Bearer owner"), que ignora estas regras.
service cloud.firestore {
  match /databases/{database}/documents {
    match /categorias/{categoriaId} {
      allow read: if true;
      allow write: if false;
    }
    match /produtos/{produtoId} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
